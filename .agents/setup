#!/usr/bin/env bash
# Orb setup: the skill has no package dependencies. Agents need the skills.sh
# CLI to validate the skill (`skills add . --list`) and curl/jq to query the
# HelloAO Bible API.
set -euo pipefail

SKILLS_CLI_VERSION="1.7.4" # requires Node >= 22.20.0

step() { printf '\n==> %s\n' "$*"; }

step "Checking system tools"
missing=()
for pkg in curl jq; do
  command -v "$pkg" >/dev/null || missing+=("$pkg")
done
if ((${#missing[@]})); then
  time { sudo apt-get update -qq && sudo apt-get install -y -qq "${missing[@]}"; }
fi

step "Checking Node.js"
node -e 'const [a,b]=process.versions.node.split(".").map(Number); if (a<22||(a===22&&b<20)) { console.error(`Node ${process.version} is too old for skills@'"$SKILLS_CLI_VERSION"' (needs >=22.20.0)`); process.exit(1) }'
node --version

step "Installing skills CLI ${SKILLS_CLI_VERSION}"
if [[ "$(npm ls -g skills --depth=0 --json 2>/dev/null | jq -r '.dependencies.skills.version // empty')" != "$SKILLS_CLI_VERSION" ]]; then
  time npm install -g --no-fund --no-audit "skills@${SKILLS_CLI_VERSION}"
fi
command -v skills
